def testRoot = System.getenv('M03_TEST_ROOT')
if (!testRoot || !new File(testRoot).isAbsolute() || !new File(testRoot).isDirectory()) {
    throw new IllegalArgumentException('Set M03_TEST_ROOT to a fresh absolute temporary directory; see tests/README.md')
}
def testWork = new File(testRoot, 'nf-test')
if (testWork.exists()) {
    throw new IllegalArgumentException('M03_TEST_ROOT already contains nf-test work; use a fresh temporary directory')
}

config {
    requires 'nf-test': '0.9.5'
    testsDir 'tests'
    configFile 'nextflow.config'
    workDir testWork.absolutePath
    profile 'local'
    withTrace false
}
